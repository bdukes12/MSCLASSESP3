   "source": [
    "cols = [\"tempC\", \"atempC\", \"humPct\", \"windKph\", \"cnt\"]\n",
    "X = d[cols].to_numpy(dtype=float)\n",
    "n, p = X.shape\n",
    "\n",
    "xbar = X.T @ np.ones(n) / n  # TODO\n",
    "Xc = X - xbar\n",
    "S = Xc.T @ Xc / (n - 1)  # TODO\n",
    "D_inv_sqrt = np.diag(1 / np.sqrt(np.diag(S)))\n",
    "R = D_inv_sqrt @ S @ D_inv_sqrt  # TODO\n",
    "\n",
    "print(\"x-bar from X'1/n           == pandas mean:\", np.allclose(xbar, d[cols].mean()))\n",
    "print(\"S from Xc'Xc/(n-1)         == pandas cov: \", np.allclose(S, d[cols].cov()))\n",
    "print(\"R from D^-1/2 S D^-1/2     == pandas corr:\", np.allclose(R, d[cols].corr()))\n",
    "pd.DataFrame(R, index=cols, columns=cols).round(3)"
   ]

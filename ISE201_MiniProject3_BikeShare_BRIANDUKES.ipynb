    "import hashlib\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import scipy.linalg as la\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "np.set_printoptions(precision=4, suppress=True)\n",
    "pd.set_option(\"display.precision\", 3)\n",
    "\n",
    "SIS_ID = \"020762248\"          # <-- replace with YOUR 9-digit SIS User ID\n",
    "\n",
    "\n",
    "raw = pd.read_csv(\"day-1.csv\", parse_dates=[\"dteday\"])  # professor-provided corrected dataset\n",
    "\n",
    "def window_for(sis_id):\n",
    "    starts = pd.date_range(\"2011-01-01\", \"2012-01-01\", freq=\"MS\")   # 13 possible windows\n",
    "    k = int(hashlib.sha256(str(sis_id).strip().encode()).hexdigest(), 16) % len(starts)\n",
    "    return starts[k]\n",
    "\n",
    "start = window_for(SIS_ID)\n",
    "end = start + pd.DateOffset(years=1)\n",
    "d = raw[(raw.dteday >= start) & (raw.dteday < end)].reset_index(drop=True)\n",
    "\n",
    "# Convert the dataset's normalized weather columns back to real units (UCI documentation)\n",
    "d[\"tempC\"]  = d.temp * 41        # air temperature, deg C\n",
    "d[\"atempC\"] = d.atemp * 50       # \"feels-like\" temperature, deg C\n",
    "d[\"humPct\"] = d.hum * 100        # relative humidity, %\n",
    "d[\"windKph\"] = d.windspeed * 67  # wind speed, km/h\n",
    "\n",
    "print(f\"SIS ID {SIS_ID}: window {start:%b %Y} to {(end - pd.Timedelta(days=1)):%b %Y}, {len(d)} days\")\n",
    "d[[\"dteday\", \"weathersit\", \"tempC\", \"atempC\", \"humPct\", \"windKph\", \"casual\", \"registered\", \"cnt\"]].head()"
   ]
  },
